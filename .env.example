# Copy this file to .env and adjust for your machine.

# PostgreSQL 16 connection for the app.
DATABASE_URL="postgresql://adr:adr_dev_password@localhost:5432/adr_reporter?schema=public"

# Separate database for automated tests. It is seeded once if empty; tests add their own cases and never wipe it.
TEST_DATABASE_URL="postgresql://adr:adr_dev_password@localhost:5432/adr_reporter_test?schema=public"

# Show the fictional demo accounts and their shared password on the login page ("false" hides them).
DEMO_MODE=true

# How long a login session lasts, in hours.
SESSION_TTL_HOURS=12

# AI features: Ollama Cloud first, then Gemini. Missing keys are skipped.
# auto (or empty) uses the default chain; none disables AI; fixture uses saved test replies.
# Comma lists can select providers, e.g. ollama,gemini,anthropic.
# Paid Claude remains BLOCKED unless ALLOW_PAID_AI is true in src/server/ai/config.ts.
AI_PROVIDER=auto
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# Leave empty for Ollama Cloud. For a local Ollama server: http://localhost:11434
# A deployed Edge Function needs a reachable server URL, not your PC's localhost.
OLLAMA_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
# Optional; only read after the code switch above is enabled and free providers fail.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_EFFORT=
# Shared request deadline, milliseconds (maximum 140000).
AI_TOTAL_TIMEOUT_MS=140000

# Public website configuration goes in .env.development / .env.production.
# Never prefix provider keys or DATABASE_URL with NEXT_PUBLIC_.

# Private scheduler credential. npm run chatbot:prepare creates supabase/.env.chat.
# Not needed for reading from an open conversation; used for scheduled background jobs.
CHAT_WORKER_SECRET=
