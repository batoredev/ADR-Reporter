# Copy this file to .env and adjust for your machine.

# PostgreSQL 16 connection for the app.
DATABASE_URL="postgresql://adr:adr_dev_password@localhost:5432/adr_reporter?schema=public"

# Separate database for automated tests. It is seeded once if empty; tests add their own cases and never wipe it.
TEST_DATABASE_URL="postgresql://adr:adr_dev_password@localhost:5432/adr_reporter_test?schema=public"

# Show the fictional demo accounts and their shared password on the login page ("false" hides them).
DEMO_MODE=true

# How long a login session lasts, in hours.
SESSION_TTL_HOURS=12

# AI prescription extraction. Provider and model are configuration, not code.
# AI_PROVIDER:
#   none       AI features show as unavailable (default)
#   anthropic  Claude via the Anthropic API; needs AI_API_KEY (or ANTHROPIC_API_KEY)
#   fixture    saved test data for the sample prescription; no key or network needed
# AI_MODEL: model identifier; leave empty for the provider's default (anthropic: claude-opus-5-5).
# AI_EFFORT: optional effort level for models that support it (low, medium, high).
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_EFFORT=
