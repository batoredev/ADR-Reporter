{
  "name": "adr-reporter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:init": "prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "test:db:init": "node scripts/with-test-db.mjs npm run db:init",
    "format:check": "prettier --check .",
    "dev:api": "tsx watch --conditions=react-server src/server/api/node-server.ts",
    "build:api": "node scripts/build-api.mjs",
    "preview": "node scripts/serve-static.mjs out 3000",
    "prebuild": "node scripts/prepare-site.mjs",
    "ai:check": "tsx --conditions=react-server scripts/check-ai.ts",
    "ai:evaluate": "tsx --conditions=react-server scripts/evaluate-extractor.ts",
    "chatbot:prepare": "node scripts/prepare-chatbot-deploy.mjs",
    "ai:chat-check": "tsx --conditions=react-server scripts/check-chat-provider.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
