# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Local agent runtime state
/.claude-flow/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Public settings only (the API address); never put passwords in these.
!.env.production
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client
/src/generated/

# uploaded documents (private, local only)
/storage/

# playwright
/test-results/
/playwright-report/
/playwright/.cache/


# Copied from docs/reference at build (npm run build)
/public/forms/
